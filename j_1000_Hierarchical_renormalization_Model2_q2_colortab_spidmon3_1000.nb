Cell[BoxData[{
 RowBox[{
  RowBox[{"colortab", "=", 
   RowBox[{"Reverse", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Delete", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"Union", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Delete", "[", 
                RowBox[{
                 RowBox[{"Sort", "[", 
                  RowBox[{"Union", "[", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"i", "+", "j", "+", "k"}], "==", "n"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", "1", ")"}], "^", "2"}], ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", "j"}], ")"}], "^", "2"}], ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", "k"}], ")"}], "^", "2"}]}], "}"}], ",", 
                    
