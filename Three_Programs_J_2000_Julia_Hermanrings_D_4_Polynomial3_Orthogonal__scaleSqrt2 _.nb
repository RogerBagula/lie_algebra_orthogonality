Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  FractionBox[
   RowBox[{
    SuperscriptBox["x", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"28.", "-", 
      RowBox[{"44.", "*", " ", "x"}], "+", 
      RowBox[{"27.", "*", 
       SuperscriptBox["x", "2"]}], "-", 
      RowBox[{"8.`", " ", 
       SuperscriptBox["x", "3"]}], "+", 
      SuperscriptBox["x", "4"]}], ")"}]}], 
   RowBox[{"4", "-", 
    RowBox[{"20", " ", "x"}], "+", 
    RowBox[{"21", " ", 
     SuperscriptBox["x", "2"]}], "-", 
    RowBox[{"8", " ", 
     SuperscriptBox["x", "3"]}], "+", 
    SuperscriptBox["x", "4"]}]]}]], "Input",
 CellChangeTimes->{{3.573570841168227*^9, 3.57357086954882*^9}, {
   4.003144834144977*^9, 4.003144844622693*^9}, 4.0031525082895803`*^9},
 CellLabel->"In[7]:=",ExpressionUUID->"db665fee-3d27-4bde-a521-e7c78a3c4e2c"],

