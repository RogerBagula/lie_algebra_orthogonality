Cell["\<\
(*Mandelbrot with SQRT(x^2+y^2) limited measure*)
(*by R. L. BAGULA 28 Nov 2026 \[Copyright] *)
numberOfz2ToEscape[z_] := Block[
\t{escapeCount, nz = N[z],nzold=0},
\tFor[
\t\tescapeCount = 0,
\t\t(Sqrt[Re[nz]^2+Im[nz]^2] < 32) && (escapeCount < 1024) && \
(Abs[nz-nzold]>.5*10^(-3)),
\t\tnzold=nz;
\t\tnz=f[nz]/10.;
\t\t++escapeCount
\t];
\tescapeCount*(1-Abs[Arg[nz]/(2*Pi)])
]\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.573303471959337*^9, 3.573303498324643*^9}, {
   3.573570907701185*^9, 3.573570915522765*^9}, {3.573580038437237*^9, 
   3.573580039557383*^9}, {4.00314486032683*^9, 4.0031448638128567`*^9}, {
   4.003145421019313*^9, 4.003145424322987*^9}, {4.003145723325243*^9, 
   4.003145733124566*^9}, 4.0031894427234364`*^9, 4.003189788682231*^9, {
   4.003256232136147*^9, 4.003256234943982*^9}, {4.003256997405938*^9, 
   4.003257008965273*^9}, {4.0032998733060493`*^9, 4.0032998743219*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->
  "In[134]:=",ExpressionUUID->"a11e9d85-a727-4840-8728-781e0a716825"],

Cell["\<\
FractalPureM[{{ReMin_, ReMax_, ReSteps_},
\t\t\t {ImMin_, ImMax_, ImSteps_}}] :=
\t\tParallelTable[
\t\t\tnumberOfz2ToEscape[x + y I],
\t\t\t{y, ImMin, ImMax, (ImMax - ImMin)/ImSteps},
\t\t\t{x, ReMin, ReMax, (ReMax - ReMin)/ReSteps}
\t\t
\t]
\t\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.003144869420603*^9, 4.003144875452599*^9}},
 AspectRatioFixed->True,
 FontSize->14,
